{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "MQTTnet": "Information"
    }
  },
  "AllowedHosts": "*",
  "Backend": {
    "Environment": "Development",
    "Security": {
      "SecretKey": "CHANGE_THIS_TO_A_SECURE_SECRET_KEY_IN_PRODUCTION",
      "Salt": "CHANGE_THIS_SALT_VALUE_IN_PRODUCTION",
      "JwtIssuer": "DeltaList",
      "JwtAudience": "DeltaListDevices",
      "JwtExpirationMinutes": 60
    },
    "Storage": {
      "ConnectionString": "",
      "EventsContainerName": "events",
      "BlacklistContainerName": "blacklist",
      "EnableCompression": true
    },
    "Redis": {
      "ConnectionString": "localhost:6379",
      "InstanceName": "DeltaList:",
      "DatabaseId": 0
    },
    "Monitoring": {
      "EnablePrometheus": true,
      "EnableOpenTelemetry": true,
      "OtlpEndpoint": "",
      "MetricsPort": 9090
    },
    "Mqtt": {
      "BrokerHost": "emqx",
      "BrokerPort": 1883,
      "ClientId": "DeltaListBackend",
      "Username": "",
      "Password": "",
      "UseTls": false,
      "KeepAlivePeriodSeconds": 60,
      "MaxPendingMessages": 10000
    }
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "MQTTnet": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": ["FromLogContext"],
    "Properties": {
      "Application": "MqttBackend"
    }
  }
}
