# DeltaList - Environment Variables Template
# Copy this file to .env.production and fill in the values
# NEVER commit .env.production to Git!

#############################################################################
# Azure Container Registry
#############################################################################
ACR_NAME=your-acr-name
IMAGE_TAG=v1.0.0

#############################################################################
# Redis Configuration
#############################################################################
# Format: host:port,password=xxx,ssl=false
# For in-cluster Redis: redis.deltalist.svc.cluster.local:6379
REDIS_CONNECTION_STRING=redis.deltalist.svc.cluster.local:6379

#############################################################################
# Security - MUST BE CHANGED IN PRODUCTION
#############################################################################
# Generate with: openssl rand -base64 32
SECURITY_SECRET_KEY=CHANGE_ME_openssl_rand_base64_32

# Generate with: openssl rand -base64 24
SECURITY_SALT=CHANGE_ME_openssl_rand_base64_24

# JWT signing key (min 32 characters)
# Generate with: openssl rand -base64 32
JWT_SIGNING_KEY=CHANGE_ME_openssl_rand_base64_32

# AES-256 encryption key (32 bytes base64)
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=CHANGE_ME_openssl_rand_base64_32

#############################################################################
# MQTT Backend Specific (PoC B)
#############################################################################
# MQTT broker credentials
MQTT_USERNAME=deltalist-backend
MQTT_PASSWORD=CHANGE_ME_openssl_rand_base64_24

#############################################################################
# EMQX Configuration
#############################################################################
# EMQX cluster node cookie (must be same across all nodes)
# Generate with: openssl rand -hex 32
EMQX_NODE_COOKIE=CHANGE_ME_openssl_rand_hex_32

# EMQX dashboard admin password
# Generate with: openssl rand -base64 24
EMQX_DASHBOARD_PASSWORD=CHANGE_ME_openssl_rand_base64_24

# EMQX API credentials (optional)
# Generate with: openssl rand -base64 32
EMQX_API_KEY=CHANGE_ME_openssl_rand_base64_32
EMQX_API_SECRET=CHANGE_ME_openssl_rand_base64_32

#############################################################################
# Azure Key Vault (Optional - for production)
#############################################################################
# AZURE_CLIENT_ID=your-managed-identity-client-id
# AZURE_TENANT_ID=your-azure-tenant-id
# AZURE_KEYVAULT_NAME=your-keyvault-name

#############################################################################
# Kubernetes Namespace
#############################################################################
K8S_NAMESPACE=deltalist

#############################################################################
# Monitoring (Optional)
#############################################################################
# PROMETHEUS_ENDPOINT=http://prometheus:9090
# GRAFANA_ENDPOINT=http://grafana:3000

#############################################################################
# Generate all secrets at once
#############################################################################
# Run this to generate all secrets:
#
# export ACR_NAME="your-acr-name"
# export IMAGE_TAG="v1.0.0"
# export REDIS_CONNECTION_STRING="redis.deltalist.svc.cluster.local:6379"
# export SECURITY_SECRET_KEY=$(openssl rand -base64 32)
# export SECURITY_SALT=$(openssl rand -base64 24)
# export JWT_SIGNING_KEY=$(openssl rand -base64 32)
# export ENCRYPTION_KEY=$(openssl rand -base64 32)
# export MQTT_USERNAME="deltalist-backend"
# export MQTT_PASSWORD=$(openssl rand -base64 24)
# export EMQX_NODE_COOKIE=$(openssl rand -hex 32)
# export EMQX_DASHBOARD_PASSWORD=$(openssl rand -base64 24)
# export EMQX_API_KEY=$(openssl rand -base64 32)
# export EMQX_API_SECRET=$(openssl rand -base64 32)
#
# Then save to .env.production:
# cat > .env.production <<EOF
# ACR_NAME=${ACR_NAME}
# IMAGE_TAG=${IMAGE_TAG}
# REDIS_CONNECTION_STRING=${REDIS_CONNECTION_STRING}
# SECURITY_SECRET_KEY=${SECURITY_SECRET_KEY}
# SECURITY_SALT=${SECURITY_SALT}
# JWT_SIGNING_KEY=${JWT_SIGNING_KEY}
# ENCRYPTION_KEY=${ENCRYPTION_KEY}
# MQTT_USERNAME=${MQTT_USERNAME}
# MQTT_PASSWORD=${MQTT_PASSWORD}
# EMQX_NODE_COOKIE=${EMQX_NODE_COOKIE}
# EMQX_DASHBOARD_PASSWORD=${EMQX_DASHBOARD_PASSWORD}
# EMQX_API_KEY=${EMQX_API_KEY}
# EMQX_API_SECRET=${EMQX_API_SECRET}
# EOF
#
# Load with: source .env.production
