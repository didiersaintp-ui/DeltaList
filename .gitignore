## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
build/
bld/
[Bb]in/
[Oo]bj/

# Visual Studio 2015 cache/options directory
.vs/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/
**/Properties/launchSettings.json

# Rider
.idea/

# VS Code
.vscode/

# macOS
.DS_Store

# Azure Functions
local.settings.json

# Terraform
.terraform/
*.tfstate
*.tfstate.backup

# Kubernetes
secrets.yaml
*-secret.yaml

# Environment variables
.env
*.env

# Logs
logs/
*.log

# Test results
TestResults/
*.trx

# Coverage
coverage/
*.coverage
*.coveragexml
